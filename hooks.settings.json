{
  "hooks": {
    "SessionEnd": [
      {
        "matcher": "prompt_input_exit|logout|other",
        "hooks": [
          {
            "type": "command",
            "command": "__PY__ -c \"import pathlib; exec(open(str(pathlib.Path.home()/'.claude'/'hooks'/'session-end-sync.py')).read())\"",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/notify.sh\"",
            "async": true,
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "__PY__ -c \"import pathlib; exec(open(str(pathlib.Path.home()/'.claude'/'hooks'/'file-size-guard.py')).read())\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "__PY__ -c \"import pathlib; exec(open(str(pathlib.Path.home()/'.claude'/'hooks'/'git-fetch-guard.py')).read())\"",
            "timeout": 35
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "__PY__ -c \"import pathlib; exec(open(str(pathlib.Path.home()/'.claude'/'hooks'/'pdf-to-text.py')).read())\"",
            "timeout": 70
          }
        ]
      }
    ]
  }
}
